# Google Gemini API Key (Optional - Heuristic fallback NLP parser is active when omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database URL (Defaults to SQLite; easily swappable for PostgreSQL / PostGIS)
DATABASE_URL=sqlite:///./disaster_response.db

# Backend API Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
API_BASE_URL=http://localhost:8000/api/v1

# Rourkela Demo Zone Coordinates
DEFAULT_LAT=22.2604
DEFAULT_LON=84.8536
DEFAULT_DISTRICT=Rourkela
