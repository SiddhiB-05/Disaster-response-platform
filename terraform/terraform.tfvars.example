# AWS Region and Environment
aws_region   = "ap-south-1"
environment  = "production"
project_name = "disaster-response-platform"

# Sizing for 30-40 Hackathon Users (Costs ~$7.50 - $8.50/month total)
# Options: "t3.small" (2 vCPU, 2 GB RAM ~$7.50/mo) | "t3.micro" (1 GB RAM - Free Tier $0.00/mo)
instance_type = "t3.small"
volume_size   = 20

# GitHub Repository to clone
github_repo_url = "https://github.com/smit45-m/Disaster-response-platform.git"

# Optional Gemini AI API Key
# gemini_api_key = "AIzaSy..."
# gemini_model   = "gemini-2.5-flash"
